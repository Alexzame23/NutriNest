<?xml version="1.0" encoding="utf-8"?>
<!--
    Languages NutriNest ships. Declaring them lets Android 13+ offer a
    per-app language picker in system settings, so a Spanish speaker can run
    the app in Spanish without changing the whole device.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="es" />
</locale-config>
